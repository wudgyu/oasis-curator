# ============================================
# Oasis Curator · 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ---------- 部署模式 ----------
# cloud: 使用云端 LLM API（DeepSeek/Kimi）
# offline: 使用本地模型（Ollama + Qwen + BGE）
DEPLOY_MODE=cloud

# ---------- 云端 LLM 配置 ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
ARK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# LLM 默认模型与路由
LLM_DEFAULT_PROVIDER=deepseek
LLM_FALLBACK_PROVIDERS=kimi,ark

# ---------- Embedding 配置 ----------
# 云端模式
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL_CLOUD=embedding-2

# 离线模式
EMBEDDING_MODEL_OFFLINE=BAAI/bge-large-zh-v1.5

# ---------- 向量数据库 ----------
VECTOR_DB=chromadb
CHROMA_PERSIST_DIR=./data/chroma
# MILVUS_URI=./data/milvus.db

# ---------- 数据库 ----------
DATABASE_URL=sqlite:///./data/oasis_curator.db
# 生产环境推荐 PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/oasis_curator

# ---------- JWT 认证 ----------
JWT_SECRET=change-me-to-a-random-32-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------- 服务端口 ----------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---------- 离线模式专用 ----------
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- 存储 ----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=./data/logs
