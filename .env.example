# ============================================
# Oasis Curator · 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ---------- 部署模式 ----------
# cloud: 使用云端 LLM API（DeepSeek/Kimi）
# offline: 使用本地模型（Ollama + Qwen + BGE）
DEPLOY_MODE=cloud

# ---------- 云端 LLM 配置 ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
ARK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# LLM 默认模型与路由
LLM_DEFAULT_PROVIDER=deepseek
LLM_FALLBACK_PROVIDERS=kimi,ark

# ---------- Embedding 配置 ----------
# auto 优先级: 智谱 embedding-2（1024 维）> Ollama bge-m3（1024 维）> 本地 MiniLM（384 维）
# 注意：切换模型后需清空向量库重新导入（维度不同）
EMBEDDING_PROVIDER=auto
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
ZHIPU_EMBEDDING_MODEL=embedding-2
OLLAMA_EMBED_MODEL=bge-m3

# ---------- 向量数据库（ChromaDB 服务端模式） ----------
# 需先 docker 启动 ChromaDB 并执行 backend/scripts/init_chroma.py 初始化
CHROMA_HOST=localhost
CHROMA_PORT=18000
CHROMA_TENANT=curator
CHROMA_DATABASE=oasis

# ---------- 数据库 ----------
DATABASE_URL=sqlite:///./data/oasis_curator.db
# 生产环境推荐 PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/oasis_curator

# ---------- JWT 认证 ----------
JWT_SECRET=change-me-to-a-random-32-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------- 服务端口 ----------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---------- 离线模式专用 ----------
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- 存储 ----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=./data/logs
